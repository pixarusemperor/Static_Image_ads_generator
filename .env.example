# ==============================================================================
# Static Image Ads Generator & SYNPHONYS Creative Engine - Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & Core App Services
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for AI Live Chat & Reference Ad Analysis)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Local Development Port
PORT=3000

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Object Storage (Optional - Falls back to local disk if empty)
# ------------------------------------------------------------------------------
# Find these in your Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=static-image-ads

# Public CDN Domain or R2 Dev Domain (e.g., https://media.superads.orizongroup.online or https://pub-xxx.r2.dev)
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 3. Headless CLI & SYNPHONYS Agent API URL
# ------------------------------------------------------------------------------
# Used by scripts/cli.mjs when rendering ads from external scripts or terminal
ADS_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Coolify Deployment & Webhook Configuration (Production)
# ------------------------------------------------------------------------------
COOLIFY_BASE_URL=https://coolifyone.orizongroup.online
COOLIFY_API_TOKEN=
COOLIFY_APP_UUID=itg0ipriumh9bqd11p3lr8ro
COOLIFY_WEBHOOK=https://coolifyone.orizongroup.online/api/v1/deploy?uuid=itg0ipriumh9bqd11p3lr8ro&force=false
